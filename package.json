{
  "name": "ai-buddy-root",
  "version": "1.0.0",
  "description": "AI Buddy monorepo root — workspace orchestration only",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "predev": "node scripts/freePorts.js 3000 5012",
    "dev": "concurrently --names SERVER,CLIENT --prefix-colors cyan,magenta \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "install:all": "npm install",
    "validate:env": "node scripts/validateEnv.js",
    "seed": "npm run seed --workspace=server",
    "ingest": "npm run ingest --workspace=server --",
    "vector:index": "npm run vector:index --workspace=server",
    "test:schemas": "npm run test:schemas --workspace=server",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

