# ─────────────────────────────────────────────────────────
# client/.env.example
# Copy to client/.env and fill in real values.
# All Vite env vars MUST be prefixed with VITE_
# They are embedded at build time — never put secrets here.
# ─────────────────────────────────────────────────────────

# Backend API base URL (Vite dev proxy handles /api → this)
VITE_API_URL=http://localhost:5012/api

# App name shown in the UI
VITE_APP_NAME=AI Buddy

# App version
VITE_APP_VERSION=1.0.0
