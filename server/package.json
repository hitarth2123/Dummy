{
  "name": "ai-buddy-server",
  "version": "1.0.0",
  "description": "AI Buddy — Node.js/Express backend",
  "private": true,
  "main": "app.js",
  "scripts": {
    "prestart": "node ../scripts/freePorts.js 3000 5012",
    "start": "node server.js",
    "predev": "node ../scripts/freePorts.js 3000 5012",
    "dev": "nodemon --ignore src/dataset --ignore src/config server.js",
    "build": "node ../scripts/validateServerBuild.js",
    "validate:env": "node ../scripts/validateEnv.js",
    "seed": "node ../scripts/seedDb.js",
    "ingest": "node ../scripts/ingestContent.js",
    "vector:index": "node ../scripts/createVectorIndex.js",
    "test": "jest --runInBand --forceExit",
    "test:schemas": "jest tests/schemas.test.js --runInBand --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "pdf-parse": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "nodemon": "^3.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
