# ─────────────────────────────────────────────────────────
# server/.env.example
# Copy to server/.env and fill in real values
# ─────────────────────────────────────────────────────────

# Node
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=ai_buddy

# JWT
JWT_SECRET=<min-32-char-random-secret-change-this>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<min-32-char-random-refresh-secret-change-this>
JWT_REFRESH_EXPIRES_IN=7d

# Mailer (SMTP)
MAILER_HOST=smtp.example.com
MAILER_PORT=587
MAILER_USER=noreply@example.com
MAILER_PASS=your-smtp-password
MAILER_FROM="AI Buddy <noreply@example.com>"
MAILER_STRICT_STARTUP=false

# Groq AI service
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# Use these names for the parallel Groq key pool. Add up to four keys.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Legacy single-key and comma-separated formats remain supported.
GROQ_API_KEY=
GROQ_API_KEYS=
ETHICS_LAYER2_THRESHOLD=0.75
REDIS_URL=redis://127.0.0.1:6379
APINEX_BASE_URL=https://api.apinex.ai/v1
APINEX_MODEL=free/claude-sonnet-4.6
APINEX_API_KEY=
DEVDOCS_BASE_URL=http://127.0.0.1:9292
SEED_MODE=false

# Vector DB Provider: pinecone | qdrant | weaviate | mongodb
VECTOR_DB_PROVIDER=mongodb
PINECONE_API_KEY=
PINECONE_INDEX=
QDRANT_URL=

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:3000
GRIEVANCE_RECIPIENT_EMAIL=caper.pvt.ltd@example.com

# Local-only login shortcut; never enable in production
DEV_LOGIN_ENABLED=true
DEV_LOGIN_EMAIL=yourname@gmail.com
